#include "resource.h"
#include "version.h"
#include <winver.h>

IDI_OFFWORK ICON "offwork.ico"
1 RT_MANIFEST "offwork.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     OFFWORK_VERSION_RESOURCE
PRODUCTVERSION  OFFWORK_VERSION_RESOURCE
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "alertform"
            VALUE "FileDescription",  "OffWork 下班倒计时悬浮窗"
            VALUE "FileVersion",      OFFWORK_VERSION_RESOURCE_STRING
            VALUE "InternalName",     "OffWork"
            VALUE "LegalCopyright",   "Copyright (C) 2026 alertform"
            VALUE "OriginalFilename", "OffWork.exe"
            VALUE "ProductName",      "OffWork"
            VALUE "ProductVersion",   OFFWORK_VERSION_RESOURCE_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
